# Copy to .env and fill in. `npm start` loads it automatically.

PORT=3000

# Google OAuth "Web application" client ID and secret (see README → Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL, only needed in production behind a proxy, e.g. https://sjbc.example.com
PUBLIC_URL=

# Comma-separated Google emails that are ALWAYS admins (they approve everyone else).
ADMIN_EMAILS=himanshubisht858@gmail.com

# PostgreSQL connection (Azure Database for PostgreSQL, Neon, Supabase, local ...).
# Use a least-privilege app role, not the server admin. Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://sjbc_app:CHANGE_ME@your-server.postgres.database.azure.com:5432/sjbc?sslmode=require
# Optional: pool size per instance (default 10)
DB_POOL_MAX=10

# Set to production when deployed behind HTTPS (enables Secure cookies + HSTS
# and disables the local dev login).
NODE_ENV=development

# If behind a reverse proxy / platform load balancer (Render, Railway, Fly, nginx): true
TRUST_PROXY=
